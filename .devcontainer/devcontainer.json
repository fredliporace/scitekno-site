{
  "name": "scitekno-site",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.3-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "davidanson.vscode-markdownlint",
        "kilocode.Kilo-Code",
        "saoudrizwan.claude-dev",
        "ms-vscode.live-server",
        "lirobi.phone-preview"
      ]
    }
  },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "Jekyll serve" }
  },
  "remoteUser": "vscode",
  "mounts": [
		// Shared: API keys and global Cline config (safe to share)
		{
			"source": "cline-config",
			"target": "/home/vscode/.cline",
			"type": "volume"
		},
		// Per-project: Task history + conversations (isolated)
		{
			"source": "cline-history-site",
			"target": "/home/vscode/.cline-history",
			"type": "volume"
		},
		// SSH keys for git access
		{
		    "source": "ssh-keys",
		    "target": "/home/vscode/.ssh",
		    "type": "volume"
		},
		// Per-project: Kilo conversations/tasks (isolated)
		{
			"source": "kilo-history-site",
			"target": "/home/vscode/.local/share/kilo",
			"type": "volume"
		},
		// Shared: Kilo config and cache (safe to share across devcontainers)
		{
			"source": "kilo-config",
			"target": "/home/vscode/.config/kilo",
			"type": "volume"
		}
	],

	"postCreateCommand": "bash .devcontainer/post-create.sh"
	// Build fails if this is run in postStartCommand
	// "postStartCommand": "bash .devcontainer/post-start.sh"

	// // Environment variables
	// "runArgs": [
    // 	"--env-file", "${localWorkspaceFolder}/.devcontainer/odc/dev.env"
	// ],

	// Configure tool-specific properties.
	// "customizations": {
	// 	"vscode": {
	// 		"extensions": [
	// 			"ms-toolsai.jupyter",
	// 			"ms-azuretools.vscode-containers",
	// 			"ms-python.mypy-type-checker",
	// 			"ms-python.black-formatter"
	// 		]
	// 	}
	// }

}