#!/usr/bin/env ruby
# Validate the translation catalogs in _data/locales/*.yml.
#
# Checks (exit 1 when any fails):
#   1. All catalogs expose the same top-level keys (parity).
#   2. No catalog defines a top-level key twice (duplicates). YAML silently keeps
#      only the last value, so a duplicated key hides real content and can silently
#      change a rendered string.
#   3. Every `t.<key>` used by a "reachable" template (a page/layout or any template
#      it {% include %}s) is defined in every catalog — a missing key renders empty.
#   4. Every defined key is referenced by at least one reachable template (unused/
#      dead strings are reported as warnings, non-fatal).
#
#   Dynamic, data-driven references (galleries that loop over `_data/*.yml` and build
#   keys with `| append`) are expanded from the data files and counted as used.
#
# Only *reachable* templates are scanned: we start from the root *.md pages and
# _layouts/*.html and follow {% include %} references. Orphan/dead partials are not
# scanned, and HTML comments are stripped so commented-out tokens aren't counted.
#
# Usage: ruby scripts/check-locales
require 'yaml'

ROOT = File.expand_path('..', __dir__)
LOCALE_DIR = File.join(ROOT, '_data', 'locales')
INCLUDE_DIR = File.join(ROOT, '_includes')
PAGE_PATTERN = File.join(ROOT, '*.md')
LAYOUT_PATTERN = File.join(ROOT, '_layouts', '**', '*.html')
INCLUDE_RE = /{%\s*include\s+([^\s%}]+)\s*%}/
TOKEN_RE = /\bt\.([A-Za-z_][A-Za-z0-9_]*)/

# Top-level YAML keys exactly as written (keeps comments/duplicates visible).
def flat_keys(path)
  File.readlines(path).each_with_object([]) do |line, keys|
    next if line =~ /^\s*#/
    keys << Regexp.last_match(1) if line =~ /^([A-Za-z_][A-Za-z0-9_]*)\s*:/
  end
end

# Expand data-driven, dynamic locale-key references like:
#   {% for item in site.data.timelapses %}
#     {% assign ck = 'experiment_timelapses_'  | append: item.copy_id %}
#     {% assign title_key = ck | append: '_title' %}
#     {{ t[title_key] }}
# into their concrete keys (e.g. `experiment_timelapses_item_1_title`) by reading the
# entry `copy_id` values from _data/timelapses.yml. This stops such keys being reported
# as "unused" while still letting the "referenced but not defined" error catch a catalog
# that removes one of them. Fail-safe: idioms we can't parse are simply ignored.
def dynamic_used_keys(content)
  used = {}
  # (loop variable) => data file basename, e.g. item => timelapses
  loops = {}
  content.scan(/\{%\s*for\s+(\w+)\s+in\s+site\.data\.([\w.]+)\s*%\}/).each do |lv, file|
    loops[lv] = file
  end
  return [] if loops.empty?

  # basevar => [key_prefix_literal, loop_variable, field]
  bases = {}
  content.scan(/\{%\s*assign\s+(\w+)\s*=\s*'([^']+)'\s*\|\s*append:\s*(\w+)\.(\w+)\s*%\}/).each do |var, prefix, lv, field|
    bases[var] = [prefix, lv, field] if loops.key?(lv)
  end
  return [] if bases.empty?

  # derived kvar => [basevar, suffix]
  derived = {}
  content.scan(/\{%\s*assign\s+(\w+)\s*=\s*(\w+)\s*\|\s*append:\s*'(\w+)'\s*%\}/).each do |kvar, basevar, suffix|
    derived[kvar] = [basevar, suffix] if bases.key?(basevar)
  end

  # basevar => suffixes actually referenced from t[...]
  refs = {}
  content.scan(/t\[\s*(\w+)\s*\]/).each do |(var)|
    if derived.key?(var)
      basevar, suffix = derived[var]
      (refs[basevar] ||= []) << suffix
    end
  end
  content.scan(/t\[\s*(\w+)\s*\|\s*append:\s*'(\w+)'\s*\]/).each do |var, suffix|
    (refs[var] ||= []) << suffix if bases.key?(var)
  end

  refs.each do |basevar, suffixes|
    prefix, lv, field = bases[basevar]
    data_file = File.join(ROOT, '_data', "#{loops[lv]}.yml")
    next unless File.file?(data_file)
    entries = YAML.load_file(data_file) || []
    entries.each do |entry|
      next unless entry.is_a?(Hash)
      val = entry[field]
      next unless val
      suffixes.uniq.each { |sfx| used["#{prefix}#{val}_#{sfx.sub(/\A_/, "")}"] = true }
    end
  end
  used.keys
end

# Collect t.<key> tokens used across all reachable templates (pages -> layout -> includes).
def used_keys
  seen_files = {}
  used = {}
  queue = Dir[PAGE_PATTERN] + Dir[LAYOUT_PATTERN]
  until queue.empty?
    path = queue.pop
    next if seen_files[path]
    seen_files[path] = true
    content = File.read(path).gsub(%r{<!--.*?-->}m, '')
    content.scan(TOKEN_RE).flatten.each { |k| used[k] = true }
    dynamic_used_keys(content).each { |k| used[k] = true }
    content.scan(INCLUDE_RE).flatten.each do |name|
      target = File.join(INCLUDE_DIR, name)
      queue << target if File.file?(target)
    end
  end
  used.keys
end

catalog_files = Dir[File.join(LOCALE_DIR, '*.yml')].sort
abort "No locale files found in #{LOCALE_DIR}" if catalog_files.empty?

flat_by_lang = catalog_files.to_h { |f| [File.basename(f, '.yml'), flat_keys(f)] }
all_keys = flat_by_lang.values.flatten.uniq.sort

errors = []
warnings = []

catalog_files.each do |f|
  lang = File.basename(f, '.yml')
  keys = flat_by_lang[lang]
  dups = keys.group_by(&:itself).select { |_, g| g.size > 1 }.keys.sort
  errors << "#{lang}: duplicate keys: #{dups.join(', ')}" if dups.any?
  missing = all_keys - keys
  errors << "#{lang}: missing keys: #{missing.join(', ')}" if missing.any?
end

used = used_keys.sort
missing_used = used - all_keys
errors << "referenced but not defined: #{missing_used.join(', ')}" if missing_used.any?

unused = all_keys - used
warnings << "defined but never referenced: #{unused.join(', ')}" if unused.any?

if errors.any?
  abort "Locale check FAILED:\n  " + errors.join("\n  ")
else
  puts "Locale files in sync (#{catalog_files.map { |f| File.basename(f, '.yml') }.join(', ')}): #{all_keys.size} keys"
  warnings.each { |w| puts "  warning: #{w}" }
  puts 'OK'
end
